{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP requests / second",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(job_portal_http_requests_total[5m]))", "legendFormat": "requests/s" }],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "HTTP latency p95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(job_portal_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "HTTP 5xx / second",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(job_portal_http_errors_total[5m]))", "legendFormat": "5xx/s" }],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Node.js memory",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "job_portal_node_process_resident_memory_bytes", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 }
    },
    {
      "type": "timeseries",
      "title": "Database pool",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "job_portal_database_pool_connections", "legendFormat": "{{instance}} {{state}}" }],
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 }
    },
    {
      "type": "timeseries",
      "title": "Cache outcomes",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (result) (rate(job_portal_cache_operations_total[5m]))", "legendFormat": "{{result}}" }],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 }
    },
    {
      "type": "timeseries",
      "title": "Redis memory",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "redis_memory_used_bytes", "legendFormat": "used" }],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 }
    },
    {
      "type": "timeseries",
      "title": "Event-loop lag p99",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "job_portal_node_nodejs_eventloop_lag_p99_seconds", "legendFormat": "{{instance}}" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 }
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["job-portal", "production"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "Job Portal Overview",
  "uid": "job-portal-overview",
  "version": 1
}
