POSTGRES_ADMIN_PASSWORD=replace-with-random-admin-password
IDENTITY_DB_PASSWORD=replace-with-random-identity-password
USER_DB_PASSWORD=replace-with-random-user-password
COMPANY_DB_PASSWORD=replace-with-random-company-password
JOB_DB_PASSWORD=replace-with-random-job-password
RESUME_DB_PASSWORD=replace-with-random-resume-password
APPLICATION_DB_PASSWORD=replace-with-random-application-password
MATCHING_DB_PASSWORD=replace-with-random-matching-password
NOTIFICATION_DB_PASSWORD=replace-with-random-notification-password
INTERVIEW_DB_PASSWORD=replace-with-random-interview-password
JWT_SECRET=replace-with-at-least-32-random-characters
INTERNAL_SERVICE_TOKEN=replace-with-a-separate-random-service-token
S3_ACCESS_KEY=replace-with-minio-access-key
S3_SECRET_KEY=replace-with-minio-secret-key
CVJD_MATCHING_ENABLED=false
CVJD_MODEL_VERSION=experimental-v1
# AI mock interview (interview-service -> AI repo's ai-service / voice-service). Tokens = their X-Internal-Token values.
AI_SERVICE_URL=http://host.docker.internal:8000
AI_SERVICE_INTERNAL_TOKEN=
VOICE_SERVICE_URL=http://host.docker.internal:8020
VOICE_SERVICE_INTERNAL_TOKEN=
INTERVIEW_DAILY_LIMIT=3
