# Database Configuration (MySQL / MariaDB)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=job_portal

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Security Configuration (Must be at least 16 characters)
JWT_SECRET=replace_with_a_secure_jwt_secret_key_at_least_16_chars
JWT_EXPIRE=30d

# Frontend Allowed Origins (CORS)
# Multiple origins can be comma-separated: http://localhost:5173,https://your-domain.vercel.app
FRONTEND_URL=http://localhost:5173

# Optional production scalability settings
REDIS_URL=redis://redis:6379
JOBS_CACHE_TTL_SECONDS=30
API_RATE_LIMIT_PER_MINUTE=3000
UPLOAD_RATE_LIMIT_PER_HOUR=60
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000
LOG_LEVEL=info
